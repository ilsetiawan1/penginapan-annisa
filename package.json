{
  "name": "penginapan-annisa-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:web": "bun --filter '@annisa/web' dev",
    "dev:api": "bun --filter '@annisa/api' dev",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:push": "bun --filter '@annisa/db' db:push",
    "db:generate": "bun --filter '@annisa/db' db:generate",
    "db:seed": "bun --filter '@annisa/db' seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.4",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
